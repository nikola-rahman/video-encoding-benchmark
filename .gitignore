.venv/
__pycache__/
*.pyc
*.egg-info/
.env
.DS_Store

# Data layers — keep directory structure via .gitkeep
data/samples/raw/*
data/samples/prepared/*
data/outputs/*
data/results/*
!data/samples/raw/.gitkeep
!data/samples/prepared/.gitkeep
!data/outputs/.gitkeep
!data/results/.gitkeep

# Generated report artifacts
report/output/*
report/figures/*
report/data/*
!report/output/.gitkeep
!report/figures/.gitkeep
!report/data/.gitkeep

# Binary / data files never belong in the repo
*.json
*.mp4
*.pdf
*.html

# But CSVs needed by the report generator are kept
!report/data/*.csv

# Scratch encoder templates
template_*.yaml
