.venv/
__pycache__/
*.pyc
*.egg-info/
.env
.DS_Store

# Data layers — keep directory structure via .gitkeep
data/samples/raw/*
data/samples/prepared/*
data/outputs/*
data/results/*
!data/samples/raw/.gitkeep
!data/samples/prepared/.gitkeep
!data/outputs/.gitkeep
!data/results/.gitkeep

# Generated report artifacts
report/output/*
report/figures/*
report/data/*
!report/output/.gitkeep
!report/figures/.gitkeep
!report/data/.gitkeep
